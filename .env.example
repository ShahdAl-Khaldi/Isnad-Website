APP_NAME=ISNAD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
# ISNAD settings (see config/isnad.php)
# ─────────────────────────────────────────────────────────────

# PayPal donation link (PAYPAL_DONATION_URL).
# Example: https://www.paypal.com/donate/?hosted_button_id=XXXXXXXX
# If this is empty, donation buttons show "Donation link coming soon".
PAYPAL_DONATION_URL=https://www.paypal.com/donate/?hosted_button_id=LRRJ2ASN8ULU2
# true ONLY if your link accepts ?amount=… (https://www.paypal.com/donate?business=you@example.org style)
PAYPAL_APPEND_AMOUNT=false

# Contact details shown on the site (leave empty = "to be provided")
ISNAD_CONTACT_EMAIL=isnadgazaeducation@gmail.com
ISNAD_CONTACT_PHONE="+970 56-635-2949"
# digits only, international format, no "+" — e.g. 970590000000
ISNAD_WHATSAPP=970566352949
# Social links — uncomment and fill in to show the icons
# ISNAD_INSTAGRAM_URL=
# ISNAD_FACEBOOK_URL=
# ISNAD_LINKEDIN_URL=
# ISNAD_X_URL=

# Forms are always saved in the database (view them: php artisan isnad:inquiries).
# Set this to also receive each message by email (configure MAIL_* above, e.g. Gmail SMTP).
# ISNAD_FORMS_NOTIFY_EMAIL=isnadgazaeducation@gmail.com
